#!/bin/bash
# abigen wrapper. Mainly to deal with solidity version and node_modules imports

PKG=
SOL=
OUT=
VER=
ARTIFACT=
OTHER_ARGS=

while [[ $# -gt 0 ]]; do
  case $1 in
    --pkg)
      PKG="$2"
      shift; shift; ;;
    --sol)
      SOL="$2"
      shift; shift; ;;
    --out)
      OUT="$2"
      shift; shift; ;;
    --ver)
      VER="$2"
      shift; shift; ;;
    --artifact)
      ARTIFACT="$2"
      shift; shift; ;;
    *)
      OTHER_ARGS="$OTHER_ARGS $1"
      shift; ;;
  esac
done

validate_args() {
  if [ -z "$PKG" ]; then
    echo "missing --pkg"
    exit 1
  fi
  if [ -z "$OUT" ]; then
    echo "missing --out"
    exit 1
  fi
  if [ -z "$SOL" ] && [ -z "$ARTIFACT" ]; then
    echo "missing --sol or --artifact"
    exit 1
  fi
}

run_artifact_mode() {
  if ! command -v jq >/dev/null; then
    echo "jq is required for --artifact mode"
    exit 1
  fi
  TMP_ABI=$(mktemp)
  TMP_BIN=$(mktemp)
  TMP_BIN_RUNTIME=$(mktemp)
  trap "rm -f $TMP_ABI $TMP_BIN $TMP_BIN_RUNTIME" EXIT

  jq '.abi' "$ARTIFACT" > "$TMP_ABI"

  # Auto-detect artifact format:
  #   forge:   out/Foo.sol/Foo.json -> .bytecode is {"object":"0x...","sourceMap":...}
  #   hardhat: artifacts/contracts/Foo.sol/Foo.json -> .bytecode is "0x..." (plain string)
  BYTECODE_TYPE=$(jq -r '.bytecode | type' "$ARTIFACT")
  if [ "$BYTECODE_TYPE" = "object" ]; then
    jq -r '.bytecode.object' "$ARTIFACT" | sed 's/^0x//' > "$TMP_BIN"
    jq -r '.deployedBytecode.object // empty' "$ARTIFACT" | sed 's/^0x//' > "$TMP_BIN_RUNTIME"
  else
    jq -r '.bytecode' "$ARTIFACT" | sed 's/^0x//' > "$TMP_BIN"
    jq -r '.deployedBytecode // empty' "$ARTIFACT" | sed 's/^0x//' > "$TMP_BIN_RUNTIME"
  fi

  set -x
  abigen --pkg $PKG --abi "$TMP_ABI" --bin "$TMP_BIN" --binruntime "$TMP_BIN_RUNTIME" --out $OUT $OTHER_ARGS
  { set +x; } 2>/dev/null
}

run_sol_mode() {
  if [ -n "$VER" ]; then
    if ! solc --version | grep -q "$VER"; then
      # Try https://github.com/crytic/solc-select if installed
      if command -v solc-select >/dev/null; then
        solc-select use $VER
      # Try https://github.com/alloy-rs/svm-rs if installed
      elif command -v svm >/dev/null; then
        svm use $VER
      fi
    fi
    if ! solc --version | grep -q "$VER"; then
      echo "wrong solc version. required: $VER"
      exit 1
    fi
  fi

  # abigen can't handle node_modules imports, so we symlink them
  ln -sf node_modules/@openzeppelin ./@openzeppelin
  ln -sf node_modules/@uniswap ./@uniswap
  ln -sf node_modules/openzeppelin-contracts-5.0 ./openzeppelin-contracts-5.0
  trap "rm -f ./@openzeppelin ./@uniswap ./openzeppelin-contracts-5.0" EXIT

  set -x
  abigen --pkg $PKG --sol $SOL --out $OUT $OTHER_ARGS
  { set +x; } 2>/dev/null
}

validate_args

if [ -n "$ARTIFACT" ]; then
  run_artifact_mode
else
  run_sol_mode
fi
